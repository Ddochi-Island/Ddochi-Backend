PORT=8090

TELEGRAM_BOT_TOKEN=
TG_WEBHOOK_SECRET=

# main(Django, Ddochi-Backend)이 이 서비스로 발송 요청을 보낼 때 쓰는 시크릿.
ENQUEUE_SECRET=

# Ddochi-Backend .env의 TELEGRAM_INTERNAL_TOKEN과 반드시 동일해야 함.
MAIN_SERVER_URL=http://127.0.0.1:8000
MAIN_INTERNAL_TELEGRAM_TOKEN=dev-test-telegram-internal-token

# 합재양 카드 인라인 버튼 서명 — Ddochi-Backend .env의 TG_CALLBACK_HMAC_SECRET과 동일해야 함.
TG_CALLBACK_HMAC_SECRET=
